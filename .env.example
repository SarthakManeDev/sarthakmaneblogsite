# Copy to .env for local development. On Azure, set these as App Settings.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Private admin paths — use something unguessable in production.
STUDIO_PATH=studio
DJANGO_ADMIN_PATH=django-admin

# Production only (leave empty locally to use SQLite + local media/):
# DATABASE_URL=sqlite:////home/data/db.sqlite3      # Azure default (cheapest)
# DATABASE_URL=postgres://USER:PASSWORD@HOST.postgres.database.azure.com:5432/sarthakmane?sslmode=require
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CONTAINER=media
